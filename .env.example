# Public URL of this app (no trailing slash). Must be HTTPS in production.
APP_URL=https://cartnudge.onrender.com
PORT=3000
NODE_ENV=production
DATA_DIR=./data

# 32+ random characters. Encrypts store tokens and merchant secrets at rest. Never change it after launch.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Shopify Partner Dashboard → Apps → CartNudge → Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_checkouts,read_customers
SHOPIFY_API_VERSION=2025-10

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API setup)
# Leave the phone id / token empty to run in "test mode": messages are logged, not sent.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_TEMPLATE_LANGUAGE=en
WA_COD_TEMPLATE=cod_confirm
WA_CART_TEMPLATE=cart_reminder

# Billing through Shopify. Keep BILLING_REQUIRED=false while onboarding free beta stores.
BILLING_REQUIRED=false
BILLING_LIVE=false
PLAN_NAME=CartNudge Pay-per-save
PARCEL_PRICE_INR=15
PARCEL_PRICE_USD=0.16
MONTHLY_CAP_INR=2999
MONTHLY_CAP_USD=32

CART_SWEEP_MINUTES=5

# Local preview only: serves the dashboard with demo data at /app, no Shopify needed.
# DEV_SHOP=demo.myshopify.com
